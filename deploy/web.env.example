# /etc/decamp/web.env: settings for the web app on the VPS (dotenv syntax).
# Owned by root, group decamp, mode 640. Each release links it as .env.local.
# NEXT_PUBLIC_* values are built into the app: run deploy/release.sh again
# after changing them. Never put ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN
# here; the agent runs in GitHub Actions.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS origin, e.g. https://decampwatch.example.ng
NEXT_PUBLIC_SITE_URL=
# Public HTTPS contact page or mailto: address for corrections.
NEXT_PUBLIC_CORRECTIONS_URL=
# Server-only service key (sb_secret_...) for authorised admin actions.
SUPABASE_SECRET_KEY=
