[Unit]
Description=DecampWatch NG
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=decamp
Group=decamp
WorkingDirectory=/srv/decamp/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
