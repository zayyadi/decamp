# Copy to .env.local and fill in. Never commit real values.
# Validated by lib/env.ts. An empty value counts as "not set".

# --- Web app (browser-safe) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Public HTTPS contact page or mailto: address. Required for public launch.
NEXT_PUBLIC_CORRECTIONS_URL=

# --- Server only (Next.js server code, scripts, agent) ----------------------
# Secret key (sb_secret_...) acts as the service role and bypasses RLS.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Fictional demo rows are shown or hidden by the database flag
# app_settings.demo_mode (RLS reads it): npm run seed -- --demo-mode on|off

# --- Detection agent (AGENT.md §9) ------------------------------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
ESCALATION_MODEL=claude-sonnet-5-5
CONFIDENCE_PUBLISH=0.85
CONFIDENCE_REVIEW=0.60
AGENT_LOOKBACK_HOURS=72
# Public page with project contact details; sent in the crawler User-Agent.
# Required for every agent run, including --stage=ingest and --dry-run.
AGENT_CONTACT_URL=
AGENT_MAX_LLM_CALLS_PER_RUN=60
